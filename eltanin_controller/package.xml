<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eltanin_controller</name>
  <version>0.0.0</version>
  <description>
    The control nodes. path_follower turns a path into a requested velocity by composing eltanin's
    PurePursuit with its GoalApproach, and publishes a command every cycle including the cycles it
    has nothing to follow, so that a stopped follower is never a silent one. collision_predictor,
    which owns /cmd_vel, is added in task 12.
  </description>
  <maintainer email="ryuyamamoto@pfrobotics.jp">RyuYamamoto</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- eltanin has no package.xml and therefore no rosdep key; the vendor package is what can be
       declared. Library target names (eltanin::control and friends) are never dependencies. -->
  <depend>eltanin_vendor</depend>
  <depend>eltanin_msgs</depend>
  <depend>eltanin_ros_common</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
