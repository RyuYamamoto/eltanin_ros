<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eltanin_msgs</name>
  <version>0.0.0</version>
  <description>
    Message and action definitions for the eltanin_ros navigation stack. Interfaces only: no nodes,
    no library code, and no dependency on eltanin, so that the six packages which consume these
    types cannot form a cycle.
  </description>
  <maintainer email="ryuyamamoto@pfrobotics.jp">RyuYamamoto</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- action_msgs is required by every .action; the rest are the packages the field types come
       from. Nothing here is defined that std_msgs, geometry_msgs, nav_msgs, std_srvs or map_msgs
       already provide. -->
  <depend>action_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
