<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eltanin_ros_common</name>
  <version>0.0.0</version>
  <description>
    The conversion layer between eltanin's types and ROS 2 messages, plus the small runtime pieces
    every node needs. Library only, no nodes. It builds two targets: eltanin_ros_common, the
    conversion layer, which does not depend on rclcpp, and eltanin_ros_common_runtime, the clock,
    watchdog and robot profile, which does. Only the tests that construct a node call rclcpp::init.
  </description>
  <maintainer email="ryuyamamoto@pfrobotics.jp">RyuYamamoto</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- eltanin_vendor installs eltanin into its own prefix, and that prefix is on
       AMENT_PREFIX_PATH, so find_package(eltanin) resolves. eltanin itself has no package.xml and
       therefore no rosdep key, so it cannot be declared here; the vendor package is what is
       declared. Library target names (eltanin::core and friends) are never declared as
       dependencies (N-10 / F-16). -->
  <depend>eltanin_vendor</depend>
  <depend>eltanin_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <!-- Used by eltanin_ros_common_runtime only; the conversion layer target links nothing of it. -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <!-- tf2 alone, not tf2_geometry_msgs: tf2/impl/utils.hpp already includes
       geometry_msgs/msg/quaternion.hpp, while tf2_geometry_msgs pulls in tf2_ros and
       orocos_kdl_vendor, which would make rclcpp a transitive dependency (D-T4-4). -->
  <depend>tf2</depend>
  <depend>visualization_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
